---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	generate(generate)
	check_policy(check_policy)
	execute(execute)
	evaluate_run(evaluate_run)
	repair(repair)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> generate;
	check_policy -.-> evaluate_run;
	check_policy -.-> execute;
	evaluate_run -.-> finalize;
	evaluate_run -.-> repair;
	execute --> evaluate_run;
	generate --> check_policy;
	repair --> check_policy;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
