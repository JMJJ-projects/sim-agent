# Copy to .env and fill in what you need. .env is gitignored; never commit keys.

# Provider: ollama | groq | openai | fake
LLM_PROVIDER=ollama
# Model tag for the chosen provider (e.g. an Ollama tag such as qwen2.5-coder:3b)
LLM_MODEL=
# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434
# Hosted providers (only needed when used)
GROQ_API_KEY=
OPENAI_API_KEY=
# Development only: allow the unsafe local runner (no isolation). Leave unset.
SIMAGENT_UNSAFE_LOCAL=
